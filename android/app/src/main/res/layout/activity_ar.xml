<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.tuchus.measure.MeasureOverlay
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/fade_top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabMeasure"
                style="@style/Measure.Button.OverlayToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_ruler"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Measure" />

            <Button
                android:id="@+id/tabFloor"
                style="@style/Measure.Button.OverlayToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:drawableStart="@drawable/ic_plan"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Floor plan" />

            <Button
                android:id="@+id/tabFit"
                style="@style/Measure.Button.OverlayToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_box"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Will it fit?" />
        </LinearLayout>

        <TextView
            android:id="@+id/readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/pill_readout"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:minWidth="150dp"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="4dp"
            android:text="—"
            android:textColor="@color/ink"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeMaxTextSize="38sp"
            android:maxLines="1"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:text="Starting the camera…"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/fade_bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="28dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/closeShape"
            style="@style/Measure.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_shape"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/measurePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modePairs"
                style="@style/Measure.Button.OverlayToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Separate lines" />

            <Button
                android:id="@+id/modeChain"
                style="@style/Measure.Button.OverlayToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Joined path or shape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fitPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/s_overlay"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <Spinner
                android:id="@+id/fitPreset"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/fitUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sizes in centimetres"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/fitW"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Width"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/ink"
                    android:textColorHint="#991C1B18" />

                <EditText
                    android:id="@+id/fitD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Depth"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/ink"
                    android:textColorHint="#991C1B18" />

                <EditText
                    android:id="@+id/fitH"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Height"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/ink"
                    android:textColorHint="#991C1B18" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Width"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Depth"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Height"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/turnLeft"
                    style="@style/Measure.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_turn_left"
                    android:minHeight="48dp"
                    android:text="Turn" />

                <Button
                    android:id="@+id/turnRight"
                    style="@style/Measure.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:drawableStart="@drawable/ic_turn_right"
                    android:minHeight="48dp"
                    android:text="Turn" />

                <Button
                    android:id="@+id/removeBox"
                    style="@style/Measure.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_clear"
                    android:minHeight="48dp"
                    android:text="Remove" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/undo"
                style="@style/Measure.Button.Overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_undo"
                android:text="Undo" />

            <Button
                android:id="@+id/add"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_add"
                android:contentDescription="Drop a point"
                android:paddingBottom="4dp"
                android:stateListAnimator="@null"
                android:text="+"
                android:textColor="@color/ink"
                android:textSize="42sp" />

            <Button
                android:id="@+id/clear"
                style="@style/Measure.Button.Overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_clear"
                android:text="Clear" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/units"
                style="@style/Measure.Button.Overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_ruler"
                android:text="cm" />

            <Button
                android:id="@+id/save"
                style="@style/Measure.Button.Overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:drawableStart="@drawable/ic_save"
                android:text="Save" />

            <Button
                android:id="@+id/done"
                style="@style/Measure.Button.Overlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_close"
                android:text="Done" />
        </LinearLayout>

        <Button
            android:id="@+id/share"
            style="@style/Measure.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_share"
            android:text="Share the saved photo"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
