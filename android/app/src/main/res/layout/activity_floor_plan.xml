<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/roomName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room name, shown on the plan (optional)"
        android:importantForAutofill="no"
        android:inputType="textCapWords"
        android:textColor="@color/fg" />

    <com.tuchus.measure.FloorPlanView
        android:id="@+id/plan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/walls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/fg"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/planSave"
            style="@style/Measure.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:drawableStart="@drawable/ic_save"
            android:text="Save" />

        <Button
            android:id="@+id/planShare"
            style="@style/Measure.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_share"
            android:text="Share" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/planUnits"
            style="@style/Measure.Button.Plain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:drawableStart="@drawable/ic_ruler"
            android:text="Units: cm" />

        <Button
            android:id="@+id/planDone"
            style="@style/Measure.Button.Plain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_close"
            android:text="Back to the camera" />
    </LinearLayout>
</LinearLayout>
