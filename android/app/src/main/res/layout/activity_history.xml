<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/Measure.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saved measurements" />

    <TextView
        style="@style/Measure.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap a photo to open it. Press and hold to share it. They are also in your Gallery under Pictures, Measure." />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="3dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="3dp" />

        <TextView
            android:id="@+id/empty"
            style="@style/Measure.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Nothing saved yet. Tap Save while measuring and the photo shows up here."
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/historyDone"
        style="@style/Measure.Button.Plain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_close"
        android:text="Done" />
</LinearLayout>
