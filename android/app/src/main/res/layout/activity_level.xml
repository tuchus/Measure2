<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/mode"
        style="@style/Measure.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lying flat" />

    <TextView
        android:id="@+id/angle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:text="0.0°"
        android:textColor="@color/fg"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail"
        style="@style/Measure.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="center" />

    <com.tuchus.measure.LevelView
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1" />

    <TextView
        style="@style/Measure.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Turns green within 0.3°. If it reads off on a surface you know is level, set it as level." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/calibrate"
            style="@style/Measure.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:drawableStart="@drawable/ic_level"
            android:text="Set this as level" />

        <Button
            android:id="@+id/resetCalibration"
            style="@style/Measure.Button.Plain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:drawableStart="@drawable/ic_undo"
            android:text="Undo setting" />
    </LinearLayout>

    <Button
        android:id="@+id/levelDone"
        style="@style/Measure.Button.Plain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_close"
        android:text="Done" />
</LinearLayout>
