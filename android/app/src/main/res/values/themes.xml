<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Measure" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/tape</item>
        <item name="android:textColorPrimary">@color/fg</item>
    </style>

    <style name="Theme.Measure.Camera" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Measure" />

    <style name="Measure.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:drawableTint">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Measure.Button.Big">
        <item name="android:textSize">19sp</item>
        <item name="android:minHeight">68dp</item>
    </style>

    <style name="Measure.Button.Plain">
        <item name="android:background">@drawable/bg_button_plain</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:drawableTint">@color/fg</item>
    </style>

    <style name="Measure.Button.Toggle">
        <item name="android:background">@drawable/bg_toggle</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Measure.Button.Overlay">
        <item name="android:background">@drawable/bg_overlay</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:drawableTint">@color/ink</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <style name="Measure.Button.OverlayToggle">
        <item name="android:background">@drawable/bg_overlay_toggle</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">46dp</item>
    </style>

    <style name="Measure.Heading">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Measure.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>
